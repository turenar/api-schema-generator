#!/usr/bin/env php
<?php
declare(strict_types=1);

if (file_exists($file = __DIR__ . '/../../../autoload.php')) {
    require_once $file;
} elseif (file_exists($file = __DIR__ . '/../autoload.php')) {
    require_once $file;
} elseif (file_exists($file = __DIR__ . '/../vendor/autoload.php')) {
    require_once $file;
}


use Symfony\Component\Console\Application;

$app = new Application('ApiSpecGen');
$command = new \Turenar\ApiSchema\Command\GenerateCommand();
if (method_exists($app, 'addCommand')) {
    $app->addCommand($command); // symfony/console >= 7.4
} else {
    $app->add($command);
}
$app->setDefaultCommand('gen');
$app->run();
